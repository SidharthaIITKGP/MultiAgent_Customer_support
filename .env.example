# Google Gemini — server-side default key. Visitors can also bring their own
# key from the chat UI (BYOK), which overrides this per-request.
GOOGLE_API_KEY=your_google_api_key_here

# Model name — change this to switch models without touching code.
# Note: older names like gemini-2.5-flash are being retired by Google; check
# https://ai.google.dev/gemini-api/docs/models for current model ids.
GEMINI_MODEL=gemini-3.5-flash

# Mock backend URL (used by agent tools)
BACKEND_URL=http://localhost:8000

# ChromaDB persistence directory
CHROMA_DB_PATH=./chroma_db

# Logging level: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# Database for conversations/messages/tickets. SQLite by default; swap to
# postgresql+psycopg2://user:pass@host/db for Postgres — no code change needed.
DATABASE_URL=sqlite:///./data/support.db

# Comma-separated shared-secret keys required in the X-API-Key header on every
# /api/* request (including from the chat UI itself — see frontend/web's
# settings modal, which asks for this as an "access code"). Generate a real
# random value for anything beyond local dev.
API_KEYS=devkey-change-me

# How many of this chat's own recent messages get fed back into the intake
# agent as conversation context on each new turn.
CONVERSATION_HISTORY_WINDOW=10
